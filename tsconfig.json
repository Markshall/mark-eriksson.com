{
  // Type checking only: Astro compiles the site and Node runs scripts/*.ts directly.
  // .astro files aren't checked by tsc.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["astro/client", "node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["src", "scripts", "tests", "astro.config.ts", "playwright.config.ts"]
}
