---
// The full site footer, with the contact details, on the homepage and project pages.
import { pageStats } from "../data/stats.ts";
import Arrow from "./Arrow.astro";

const { "data-year": year } = pageStats();
---

<footer id="contact" class="site-footer">
  <div class="wrap footer-main">
    <div class="contact">
      <p class="sign-off">
        Say hello<span class="accent">_</span>
      </p>
      <a class="btn btn-solid mono" href="mailto:me@mark-eriksson.com">
        me@mark-eriksson.com
      </a>
    </div>
    <nav class="mono" aria-label="Social">
      <a href="https://github.com/Markshall" target="_blank" rel="noopener noreferrer">
        GitHub
        <Arrow direction="up-right" />
      </a>
      <a href="https://www.linkedin.com/in/markeriksson/" target="_blank" rel="noopener noreferrer">
        LinkedIn
        <Arrow direction="up-right" />
      </a>
      <a href="https://codepen.io/Markshall" target="_blank" rel="noopener noreferrer">
        CodePen
        <Arrow direction="up-right" />
      </a>
    </nav>
  </div>
  <div class="wrap footer-base mono">
    <span>
      © <span data-year>{year}</span> Mark Eriksson
    </span>
    <span class="footer-links">
      <a href="/privacy/">privacy</a>
      <button type="button" class="link-btn" data-consent-open>
        cookie settings
      </button>
    </span>
    <a href="#home">
      back to top
      <Arrow direction="up" />
    </a>
  </div>
</footer>
